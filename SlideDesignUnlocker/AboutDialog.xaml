<ContentDialog
    x:Class="SlideDesignUnlocker.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Slide Design Unlocker"
    ExitDisplayModeOnAccessKeyInvoked="True"
    PrimaryButtonText="OK"
    DefaultButton="Primary">
    <StackPanel>
        <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
               Height="100"
               Margin="8" />
        <TextBlock Text="{x:Bind Version}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="© 2022 - Michaël Hompus"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Spacing="16">
            <HyperlinkButton Content="Blog"
                             NavigateUri="https://blog.hompus.nl" />
            <HyperlinkButton Content="Bluesky"
                             NavigateUri="https://bsky.app/profile/energy164.online" />
        </StackPanel>
        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0,32,0,8"
                   TextAlignment="Center">Icon made from <Hyperlink NavigateUri="http://www.onlinewebfonts.com/icon">Icon Fonts</Hyperlink> is licensed by CC BY 3.0</TextBlock>
    </StackPanel>
</ContentDialog>
