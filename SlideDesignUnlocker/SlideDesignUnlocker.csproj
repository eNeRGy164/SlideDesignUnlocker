<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>True</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SlideDesignUnlocker</RootNamespace>
    <LangVersion>preview</LangVersion>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>

    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>

    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AppxBlockMapHashAlgorithmId>http://www.w3.org/2001/04/xmlenc#sha256</AppxBlockMapHashAlgorithmId>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <PackageCertificateThumbprint>36C30E04845630F1F3268E44780866CA0CC6040D</PackageCertificateThumbprint>
  </PropertyGroup>

  <!--
    Release builds are self-contained so there is no external .NET Desktop Runtime
    dependency (Microsoft Store policy 10.2.4.1).  PublishTrimmed only takes effect
    during 'dotnet publish'; regular builds include the runtime but skip trimming.
    Use the CreateStorePackages target for fully-optimised MSIX packages.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Self-contained .NET runtime: eliminates the external desktop runtime dependency -->
    <SelfContained>true</SelfContained>

    <!-- Do NOT bundle the Windows App SDK runtime; it is delivered as a Store framework package -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!-- Trimming: remove unused code to minimise package size (publish-only) -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>

    <!-- Globalization: use invariant mode to exclude ICU / regional data -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Exclude debug-only native libraries from the MSIX payload (reduces WACK warnings and package size) -->
  <Target Name="_ExcludeDebugNativeLibraries" AfterTargets="_ComputeAppxPackagePayload"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <AppxPackagePayload Remove="@(AppxPackagePayload)"
          Condition="'%(Filename)' == 'mscordbi' or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="Assets\App.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
       Tools extension to be activated for this project even if the Windows App SDK Nuget
       package has not yet been restored -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnablePreviewMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <Import Project="StorePackaging.targets" />

</Project>
